    "db:import": "node import-dump.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
