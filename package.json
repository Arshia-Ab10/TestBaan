{
  "name": "testbaan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "open-build": "opennextjs-cloudflare build",
    "open-deploy": "opennextjs-cloudflare deploy",
    "open-upload": "opennextjs-cloudflare upload",
    "open-preview": "opennextjs-cloudflare preview",
    "cf-deploy": "wrangler deploy",
    "cf-upload": "wrangler versions upload",
    "cf-dev": "wrangler dev",
    "cf-dev-300": "wrangler dev --port 3000",
